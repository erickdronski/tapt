.DS_Store
*.log
node_modules/
.env
.env.*
!.env.example
.vercel
xcuserdata/
*.xcuserstate
build/
DerivedData/
.supabase/
__pycache__/
*.pyc
.venv/

# Beer image backfill: resume cursor is a local/CI re-check aid, never committed
# (a committed "all done" list would make every future run skip and never pick
# up images OFF crowd-sources later). Match report is a run artifact.
scripts/.image_backfill_state.json
beer_image_backfill.json

# XcodeGen output (regenerate with: cd app && xcodegen generate)
app/*.xcodeproj/
app/*.xcworkspace/
.build/

scripts/.wikidata_ingest_state.json

# Apple signing material and API keys. CI reads these from encrypted
# secrets; local copies live outside the repo (see .env.example).
*.p8
*.p12
*.pem
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
